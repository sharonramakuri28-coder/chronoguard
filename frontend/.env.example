# Backend URL used by production builds (required when you run `npm run build`).
# Set it in your hosting provider's environment settings, e.g. on Vercel, Netlify or Render.
VITE_API_URL=https://chronoguard-pt4n.onrender.com

# Local development: leave VITE_API_URL unset (or empty) and the dev server proxies /api
# to the backend below.
# DEV_API_PROXY_TARGET=http://127.0.0.1:8000
