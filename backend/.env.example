# Copy to backend/.env. Every setting is optional; defaults run fully offline.

# Database (default: SQLite file backend/chronoguard.db). Example for Azure PostgreSQL:
# CHRONOGUARD_DATABASE_URL=postgresql+psycopg://user:password@host:5432/chronoguard
# CHRONOGUARD_MAX_UPLOAD_MB=20
# Comma-separated allowed frontend origins. Default "*" (the API uses no cookies or credentials).
# CHRONOGUARD_CORS_ORIGINS=https://your-frontend.vercel.app
# CHRONOGUARD_SEED_SAMPLES_ON_STARTUP=true

# Optional Azure OpenAI: semantic embeddings for memory + written explanations.
# CHRONOGUARD_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# CHRONOGUARD_AZURE_OPENAI_API_KEY=
# CHRONOGUARD_AZURE_OPENAI_API_VERSION=2024-10-21
# CHRONOGUARD_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# CHRONOGUARD_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Optional Hindsight long-term memory. Enabled only when BOTH the base URL and the API key are set.
# Base URL: Hindsight Cloud (below) or your self-hosted server. Get a key at https://ui.hindsight.vectorize.io
CHRONOGUARD_HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
CHRONOGUARD_HINDSIGHT_API_KEY=
CHRONOGUARD_HINDSIGHT_BANK_ID=chronoguard
# Upper bound in seconds for each Hindsight call during an audit (default 10).
# CHRONOGUARD_HINDSIGHT_TIMEOUT_SECONDS=10
